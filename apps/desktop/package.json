{
  "name": "@ta/desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev:electron": "cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -n RENDERER,ELECTRON -c auto \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:renderer": "tsc -b && vite build",
    "build": "npm run build:renderer && electron-builder --win --config",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "electronVersion": "37.2.3",
    "appId": "com.richblue.trading",
    "productName": "RichBlue",
    "copyright": "Copyright © 2025 RichBlue",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RichBlue",
      "runAfterFinish": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../apps/api/dist/api",
        "to": "api",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "../../dist-installer",
      "buildResources": "public"
    },
    "asar": true,
    "asarUnpack": [
      "**/api/**"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.0",
    "lucide-react": "^0.460.0",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chart.js": "^4.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "37.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
